{
  "name": "github-widget-desktop",
  "version": "1.0.4",
  "description": "GitHub Dashboard Widget - Desktop app with system tray",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "test": "node tests/contract.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:all": "node tests/contract.test.js && node tests/integration.test.js",
    "test:precommit": "node tests/precommit.js",
    "setup-hooks": "node tests/setup-hooks.js",
    "postinstall": "node tests/setup-hooks.js"
  },
  "keywords": ["github", "widget", "electron", "desktop"],
  "author": "benclawbot",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.benclawbot.githubwidget",
    "productName": "GitHub Widget",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "widget.html"
    ]
  }
}